DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
JWT_SECRET=change-me-in-production-at-least-32-chars
# Dev only: return OTP codes in the API response instead of sending an SMS
OTP_DEV_ECHO=true
PORT=3000
# Documents (spec 06). Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
STORAGE_DIR=.data/objects
